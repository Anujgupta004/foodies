# ============================================
# Copy this file, rename to .env
# Fill in your actual values below
# ============================================

PORT=5000
NODE_ENV=development

# FROM: mongodb.com/atlas → Connect → Drivers
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/foodiesDB?retryWrites=true&w=majority

# Any long random string — keep it secret
JWT_SECRET=foodies_change_this_to_any_long_random_string_2025

# FROM: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

CLIENT_URL=http://localhost:5000

# ============================================
# WhatsApp Notifications (CallMeBot — Free)
# ============================================
# Setup: Save +34 644 97 79 16 as "CallMeBot" on WhatsApp
#        Send: I allow callmebot to send me messages
#        You'll get the API key back instantly
WHATSAPP_PHONE=919876543210
WHATSAPP_API_KEY=your_callmebot_api_key_here
